# ----------------------------
# Настройки OTLP
# ----------------------------

OTLP_HOST=${GENERAL_OTLP_HOST}
OTLP_PORT=${GENERAL_OTLP_PORT}

# ----------------------------
# Kafka настройки
# ----------------------------

# Адреса Kafka-брокеров через запятую
KAFKA_BROKERS=${ASSEMBLY_KAFKA_BROKERS}

# Название топика с событиями "Заказ оплачен"
ORDER_PAID_TOPIC_NAME=${ASSEMBLY_ORDER_PAID_TOPIC_NAME}

# Идентификатор consumer group для обработки событий "Заказ оплачен"
ORDER_PAID_CONSUMER_GROUP_ID=${ASSEMBLY_ORDER_PAID_CONSUMER_GROUP_ID}

# Название топика с событиями "Заказ собран"
ORDER_ASSEMBLED_TOPIC_NAME=${ASSEMBLY_ORDER_ASSEMBLED_TOPIC_NAME}


# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${ASSEMBLY_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${ASSEMBLY_LOGGER_AS_JSON}

# Имя сервиса
LOGGER_SERVICE_NAME=${ASSEMBLY_LOGGER_SERVICE_NAME}

# Окружение
LOGGER_SERVICE_ENVIRONMENT=${ASSEMBLY_LOGGER_SERVICE_ENVIRONMENT}

# Включить Opentelemetry
LOGGER_ENABLE_OTLP=${ASSEMBLY_LOGGER_ENABLE_OTLP}

# ----------------------------
# Настройки OTEL metrics
# ----------------------------

# Metrics
OTEL_COLLECTOR_INTERVAL=${ASSEMBLY_OTEL_COLLECTOR_INTERVAL}
OTEL_SERVICE_NAME=${ASSEMBLY_OTEL_SERVICE_NAME}